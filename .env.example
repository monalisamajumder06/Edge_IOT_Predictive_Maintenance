# =====================================================================
# Edge-IoT Predictive Maintenance Platform - Environment Configuration
# Subsystem: IoT + Backend + Dashboard (Member 3)
# =====================================================================

# ---------------------------------------------------------------------
# MQTT Broker Configuration (Mosquitto)
# ---------------------------------------------------------------------
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=edge_maint_backend_subscriber
MQTT_TOPIC_PREDICTION_PATTERN=motors/+/prediction
MQTT_TOPIC_STATUS_PATTERN=motors/+/status
MQTT_QOS=1

# ---------------------------------------------------------------------
# InfluxDB Time-Series Database Configuration
# ---------------------------------------------------------------------
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=industrial_iot
INFLUXDB_BUCKET=motor_telemetry
# In production, supply a valid API token; do not commit real tokens
INFLUXDB_TOKEN=my-secure-placeholder-token

# ---------------------------------------------------------------------
# FastAPI Application Configuration
# ---------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Dashboard Configuration (Streamlit / Grafana)
# ---------------------------------------------------------------------
DASHBOARD_PORT=8501
DASHBOARD_REFRESH_INTERVAL_SECONDS=2
